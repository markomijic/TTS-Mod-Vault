# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
.vscode/
.env

# Claude Code: CLAUDE.md and .claude/ (graphify skill, shared settings) are tracked;
# only per-machine files and the graphify graph output stay local.
.claude/settings.local.json
.claude/*.bak
.claude/*.graphify-bak
.claude/skills/graphify/*.bak
graphify-out/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/

# Widget Preview related
.widget_preview/

# Generated code (builds run `dart run build_runner build` + `flutter gen-l10n` first)
*.g.dart
*.freezed.dart
lib/l10n/generated/
